
OPENAI_API_KEY=x
# Chat (text): default gpt-5-nano — https://platform.openai.com/docs/pricing
OPENAI_MODEL=gpt-5-nano
# When a message includes an image, this model is used (must support vision). Default gpt-4o-mini.
OPENAI_VISION_MODEL=gpt-4o-mini
# Cap assistant reply length (64–4096). Default 512.
OPENAI_MAX_TOKENS=512
# Image generation: defaultgpt-image-1-mini @ 256x256 (smallest size). Or e.g. gpt-image-1-mini (low + jpeg).
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_SIZE=256x256
# Audio transcription.
OPENAI_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_AUDIO_FORMAT_SIZE=256x256
# Audio generation
OPENAI_AUDIO_GENERATION_MODEL=gpt-4o-mini-tts

# Anthropic
ANTHROPIC_API_KEY=x

# Google
GOOGLE_GENERATIVE_AI_API_KEY=x
GEMINI_MODEL=gemini-3-flash-preview

# Eleven Labs
ELEVENLABS_API_KEY=x