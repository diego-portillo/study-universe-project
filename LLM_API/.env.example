# Copy to .env.local (Next.js loads this for local dev; do not commit secrets)
OPENAI_API_KEY=a

# Chat (text): default gpt-5-nano — https://platform.openai.com/docs/pricing
OPENAI_MODEL=gpt-5-nano

# When a message includes an image, this model is used (must support vision). Default gpt-4o-mini.
OPENAI_VISION_MODEL=gpt-4o-mini

# Cap assistant reply length (64–4096). Default 512.
OPENAI_MAX_TOKENS=512

# Image generation: default dall-e-2 @ 256x256 (smallest size). Or e.g. gpt-image-1-mini (low + jpeg).
OPENAI_IMAGE_MODEL=dall-e-2
OPENAI_IMAGE_SIZE=256x256

# Anthropic
ANTHROPIC_API_KEY=a
