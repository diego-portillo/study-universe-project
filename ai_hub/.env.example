# ── Required API keys ─────────────────────────────────────────────────────────
# Only add keys for the providers you want to use.
# Each route returns 500 if its key is missing.

OPENAI_API_KEY=                        # chat, image generation, TTS, STT
ANTHROPIC_API_KEY=                     # chat only
GOOGLE_GENERATIVE_AI_API_KEY=          # chat only
ELEVENLABS_API_KEY=                    # TTS + STT only

# ── Optional model overrides ──────────────────────────────────────────────────
# Defaults shown. Override to swap models without changing code.

OPENAI_MODEL=gpt-4o                    # default chat model
OPENAI_VISION_MODEL=gpt-4o-mini        # used when message includes an image
OPENAI_IMAGE_MODEL=gpt-image-1-mini    # gpt-image-2 | gpt-image-1 | gpt-image-1-mini
                                        # (gpt-image-2 needs a higher account tier —
                                        # 429s with "Limit 0" TPM otherwise)

ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024              # cap on assistant reply length (64–4096)

OPENAI_MAX_TOKENS=1024                 # cap on assistant reply length (64–4096)

GEMINI_MODEL=gemini-2.5-flash

# ── Eval harness (npm run eval) ─────────────────────────────────────────────────
# Requires `npm run dev` running in another terminal — the harness hits the real
# /api/chat route over HTTP. Judge calls use OPENAI_API_KEY above.

EVAL_BASE_URL=http://localhost:3000    # base URL of the running app
JUDGE_MODEL=gpt-4.1-mini                # model used to grade responses against criteria
                                        # (keep this different from OPENAI_MODEL/
                                        # OPENAI_VISION_MODEL to avoid self-judging bias)

# ── Deployment ────────────────────────────────────────────────────────────────
# Set when running behind a reverse proxy at a subpath (e.g. /ai_hub).
# Leave empty for local dev and App Runner (served at root).

NEXT_PUBLIC_BASE_PATH=

# Set to "true" only for a publicly-reachable deployment (e.g. a demo URL
# anyone can hit). Gates rate limits, token caps, cheap-model default, and
# image/audio modes. Leave unset for local dev — no behavior change.
PUBLIC_DEMO_MODE=

# Total /api/* requests allowed across all IPs per UTC day, only enforced
# when PUBLIC_DEMO_MODE=true. Default 100 if unset.
DEMO_DAILY_REQUEST_CAP=100

# Total chat tokens (input + output, all models treated the same — a flat
# volume cap, not a price-weighted one) allowed per UTC day, only enforced
# when PUBLIC_DEMO_MODE=true. Default 150000 if unset.
DEMO_DAILY_TOKEN_CAP=150000
